      },
      {
        "kind": "text",
        "text": "原文 6. 初始化与打印测试："
      },
      {
        "kind": "table",
        "headers": [
          "序号",
          "项目内容"
        ],
        "rows": [
          [
            [
              {
                "kind": "text",
                "text": "6.1"
              }
            ],
            [
              {
                "kind": "text",
                "text": "在两个CDU上按MENU键；"
              }
            ]
          ],
          [
            [
              {
                "kind": "text",
                "text": "6.2"
              }
            ],
            [
              {
                "kind": "text",
                "text": "按<ACARS旁的LSK，确认显示ACARS-APPLICATION MENU；"
              }
            ]
          ],
          [
            [
              {
                "kind": "text",
                "text": "6.3"
              }
            ],
            [
              {
                "kind": "text",
                "text": "进入TECHNICAL>菜单，再进入SYSTEM CONFIG页，核对软硬件件号；"
              }
            ]
          ],
          [
            [
              {
                "kind": "text",
                "text": "6.4"
              }
            ],
            [
              {
                "kind": "text",
                "text": "按*PRINT旁LSK，确认打印机输出信息。"
              }
            ]
          ]
        ],
        "widths": [
          0.16,
          0.84
        ]
      },
      {
        "kind": "text",
        "text": "原文 7. VHF链路测试："
      },
      {
        "kind": "table",
        "headers": [
          "序号",
          "项目内容"
        ],
        "rows": [
