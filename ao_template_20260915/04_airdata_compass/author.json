  {
    "work_type": "模拟工种",
    "index": "60",
    "blocks": [
      {
        "kind": "text",
        "text": "项目名称：罗盘校准工具 – 主罗盘选项\n项目编码：TASK 34-23-00-820-801"
      },
      {
        "kind": "text",
        "text": "原文 4. 十二点精度摆动程序。"
      },
      {
        "kind": "table",
        "headers": [
          "序号",
          "项目内容"
        ],
        "rows": [
          [
            [
              {
                "kind": "text",
                "text": "4.1"
              }
            ],
            [
              {
                "kind": "text",
                "text": "在摆动区中心，依次将SCC调至0,30,…,330°磁航向。"
              }
            ]
          ],
          [
            [
              {
                "kind": "text",
                "text": "4.2"
              }
            ],
            [
              {
                "kind": "text",
                "text": "记录各30°间隔的磁航向（MH）与备用罗盘航向（CH）。"
              }
            ]
          ],
          [
            [
              {
                "kind": "text",
                "text": "4.3"
              }
            ],
            [
              {
                "kind": "text",
                "text": "将CH填入修正卡STEER栏（STEER = MH - D；000°时特殊处理）。"
              }
            ]
          ],
          [
            [
              {
                "kind": "text",
                "text": "4.4"
              }
            ],
            [
              {
                "kind": "text",
                "text": "若剩余偏差超±5°，重复四点校准或执行FIM 34-23 TASK 801。"
              }
            ]
          ]
        ],
        "widths": [
          0.16,
          0.84
        ]
      },
      {
        "kind": "text",
        "text": "原文 5. 恢复飞机状态。"
      },
      {
        "kind": "table",
        "headers": [
          "序号",
          "项目内容"
        ],
        "rows": [
          [
            [
              {
                "kind": "text",
                "text": "5.1"
              }
            ],
            [
              {
                "kind": "text",
                "text": "重连电连接器。"
              }
            ]
          ],
          [
            [
              {
                "kind": "text",
                "text": "5.2"
              }
            ],
            [
              {
                "kind": "text",
                "text": "拆下SCC，装回备用罗盘原螺钉。"
              }
            ]
          ],
          [
            [
              {
                "kind": "text",
                "text": "5.3"
              }
            ],
            [
              {
                "kind": "text",
                "text": "将支架复位并拧紧螺钉。"
              }
            ]
          ]
        ],
        "widths": [
          0.16,
          0.84
        ]
      }
    ],
