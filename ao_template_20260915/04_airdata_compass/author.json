        "text": "项目名称：大气数据基准 - 系统测试\n项目编码：TASK 34-21-00-730-802"
      },
      {
        "kind": "text",
        "text": "原文 1. 准备测试"
      },
      {
        "kind": "table",
        "headers": [
          "序号",
          "项目内容"
        ],
        "rows": [
          [
            [
              {
                "kind": "text",
                "text": "1.1"
              }
            ],
            [
              {
                "kind": "text",
                "text": "打开并挂牌：P6-2 A6 C00566 FLIGHT CONTROL FLAP LOAD RELIEF（警告：防止舵面意外移动）"
              }
            ]
          ],
          [
            [
              {
                "kind": "text",
                "text": "1.2"
              }
            ],
            [
              {
                "kind": "text",
                "text": "接通外电源（执行 TASK 24-22-00-860-813）"
              }
            ]
          ],
          [
            [
              {
                "kind": "text",
                "text": "1.3"
              }
            ],
            [
              {
                "kind": "text",
                "text": "遵守皮托管-静压系统加压注意事项："
              },
              {
                "kind": "table",
                "headers": [
                  "项次",
                  "加压约束"
                ],
                "rows": [
                  [
                    [
                      {
                        "kind": "text",
                        "text": "1"
                      }
                    ],
                    [
                      {
                        "kind": "text",
                        "text": "ADIRS 须通电"
                      }
                    ]
                  ],
                  [
                    [
                      {
                        "kind": "text",
                        "text": "2"
                      }
                    ],
                    [
                      {
                        "kind": "text",
                        "text": "压力变化需受控"
                      }
                    ]
                  ],
                  [
                    [
                      {
                        "kind": "text",
                        "text": "3"
                      }
                    ],
                    [
                      {
                        "kind": "text",
                        "text": "静压范围 3.26–33.31 in Hg，总压 3.26–41.34 in Hg"
                      }
                    ]
                  ],
                  [
                    [
                      {
                        "kind": "text",
                        "text": "4"
                      }
                    ],
                    [
                      {
                        "kind": "text",
                        "text": "静压与环境压差 ≤28 in Hg"
                      }
                    ]
                  ],
                  [
                    [
                      {
                        "kind": "text",
                        "text": "5"
                      }
                    ],
                    [
                      {
                        "kind": "text",
                        "text": "空速/高度变化率分别 <300 kt/min、<5000 ft/min"
                      }
                    ]
                  ],
                  [
                    [
                      {
                        "kind": "text",
                        "text": "6"
                      }
                    ],
                    [
                      {
                        "kind": "text",
                        "text": "pitot 压 > static 压但差值 ≤10 in Hg"
                      }
                    ]
                  ],
                  [
                    [
                      {
                        "kind": "text",
                        "text": "7"
                      }
                    ],
                    [
                      {
                        "kind": "text",
                        "text": "自动驾驶关闭"
                      }
                    ]
                  ],
                  [
                    [
                      {
                        "kind": "text",
                        "text": "8"
                      }
                    ],
                    [
                      {
                        "kind": "text",
                        "text": "探头加热关闭"
                      }
                    ]
                  ]
                ],
                "widths": [
                  0.14,
                  0.86
                ]
              }
            ]
          ],
          [
            [
              {
                "kind": "text",
                "text": "1.4"
              }
            ],
            [
              {
                "kind": "text",
                "text": "ATC 应答机置待命（SIA 702-710：Mode Select 置 STBY；SIA 711-714/716-999：Mode Reply 置 STBY）"
              }
            ]
          ]
        ],
