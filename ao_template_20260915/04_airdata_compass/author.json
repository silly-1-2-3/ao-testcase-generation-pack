      },
      {
        "kind": "text",
        "text": "原文 5. 恢复飞机状态"
      },
      {
        "kind": "table",
        "headers": [
          "序号",
          "项目内容"
        ],
        "rows": [
          [
            [
              {
                "kind": "text",
                "text": "5.1"
              }
            ],
            [
              {
                "kind": "text",
                "text": "闭合 FLAP LOAD RELIEF 跳开关"
              }
            ]
          ],
          [
            [
              {
                "kind": "text",
                "text": "5.2"
              }
            ],
            [
              {
                "kind": "text",
                "text": "ALTERNATE VMO/MMO 开关置 NORM，盖上护盖并用 G01912 锁线保险"
              }
            ]
          ],
          [
            [
              {
                "kind": "text",
                "text": "5.3"
              }
            ],
            [
              {
                "kind": "text",
                "text": "关闭 117A 电子设备舱门。"
              }
            ]
          ]
        ],
